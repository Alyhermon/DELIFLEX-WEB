# Copia este archivo como .env.local (en esta misma carpeta, la raiz del
# proyecto) y rellena lo que falte. .env.local NO se sube a git.

# Backend NestJS que tambien usa la app movil de Deliflex para sus datos
# (auth, negocios, pedidos, etc). En local suele correr en el puerto 3001;
# en produccion es https://api.deliflex.app.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Mismo proyecto Supabase que usan deliflex-admin y la app movil. La anon
# key es publica a proposito (va en el navegador) y solo puede leer lo que
# las policies de RLS dejan ver a "anon" (banners, categorias, etc) - se
# saca en Supabase -> Project Settings -> API -> anon/public.
NEXT_PUBLIC_SUPABASE_URL=https://qiokcjzdqqsgapgqlnlu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFpb2tjanpkcXFzZ2FwZ3Fsbmx1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjAyMDg2NjIsImV4cCI6MjA3NTc4NDY2Mn0.JgqL4BnjdRs_P-5TKJTWIr2s4WwUaAvnfFhycFiOAwU

# La llave de servicio (permisos totales, solo servidor) se saca en:
#   Supabase -> Project Settings -> API -> service_role (secret)
# Solo vive en el servidor (rutas app/api/**) y nunca se manda al navegador
# ni lleva prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=pega-aqui-tu-service-role-key
